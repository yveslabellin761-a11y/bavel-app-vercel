# Local reference for every runtime/build environment variable.
# Copy the needed values into an ignored .env file; never commit real secrets.
# Every VITE_* value is public and embedded in the client build.

# Required: Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-placeholder"
# Authentication emails (confirmation, password reset, email change) are sent by Supabase Auth.
# Configure Resend as Supabase's custom SMTP provider in the Supabase Dashboard.
# Do not put RESEND_API_KEY in this file or in any VITE_* variable.

# Required for native builds. Use the HTTPS origin serving the Bavel API.
VITE_API_BASE_URL=""
VITE_PAYMENTS_ENABLED="false"
# Also allow com.bavel.app://auth/callback in Supabase Auth > URL Configuration > Redirect URLs.

# Required: server and authentication
NODE_ENV="development"
PORT=3000
# Canonical public frontend origin; production must use the real HTTPS URL.
FRONTEND_URL="http://localhost:3000"
# Generate a unique secret for each environment with: openssl rand -base64 48
JWT_SECRET="replace-with-at-least-32-random-characters"

# Required in production: create an Upstash Redis database and enter its REST URL and token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Web Push. Set all server values; VITE_VAPID_PUBLIC_KEY must match VAPID_PUBLIC_KEY.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL=""
VITE_VAPID_PUBLIC_KEY=""

# Required in production: use separate Sentry projects/DSNs for Node server and browser.
# SENTRY_DSN is server-only; VITE_SENTRY_DSN is public and embedded in the web build.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"
VITE_SENTRY_DSN=""
VITE_SENTRY_TRACES_SAMPLE_RATE="0"

# Optional: Stripe payments. Configure both values to enable it.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional: mobile money payments. Configure the complete provider credentials and webhook secret.
MOBILE_MONEY_CHECKOUT_URL=""
MOBILE_MONEY_API_KEY=""
MOBILE_MONEY_MERCHANT_ID=""
MOBILE_MONEY_WEBHOOK_SECRET=""
MOBILE_MONEY_COUNTRIES=""

# Social sign-in: configure Google and Facebook in Supabase Auth > Sign In / Providers.
# Set the Supabase callback URL in each provider's console and allow the app redirect in Supabase.
# No FACEBOOK_APP_ID or Facebook SDK credentials are used by Bavel's Supabase OAuth flow.
# These optional Google values are only for the legacy server-side ID-token verification endpoint.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public legacy client ID only; never put a client secret in a VITE_* variable.
VITE_GOOGLE_CLIENT_ID=""

# Internal generative AI is intentionally disabled: there is no complete production generation adapter.
# Do not enable AI endpoints until their implementation and safety checks are ready.

# Optional Giphy integration; this key is public and subject to provider quota/terms.
VITE_GIPHY_API_KEY=""

# Optional development environment switch; do not set this in production.
DISABLE_HMR="false"
